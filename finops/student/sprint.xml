<mxfile host="app.diagrams.net">
  <diagram name="Sprint BPMN Choreography">
    <mxGraphModel grid="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Start Event -->
        <mxCell id="start" value="Start Sprint"
          style="ellipse;whiteSpace=wrap;html=1;aspect=fixed"
          vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="40" height="40" as="geometry"/>
        </mxCell>

        <!-- Sprint Planning -->
        <mxCell id="plan" value="Sprint Planning&#10;(SM ↔ PO, DEV)"
          style="rounded=1;whiteSpace=wrap;html=1"
          vertex="1" parent="1">
          <mxGeometry x="120" y="340" width="260" height="120" as="geometry"/>
        </mxCell>

        <!-- Message -->
        <mxCell id="msg1" value="Prioritized Backlog"
          style="shape=message;whiteSpace=wrap;html=1"
          vertex="1" parent="1">
          <mxGeometry x="150" y="280" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Commit -->
        <mxCell id="commit" value="Commit Sprint Backlog&#10;(DEV → PO)"
          style="rounded=1;whiteSpace=wrap;html=1"
          vertex="1" parent="1">
          <mxGeometry x="420" y="340" width="260" height="120" as="geometry"/>
        </mxCell>

        <!-- Execute Sprint -->
        <mxCell id="execute" value="Execute Sprint&#10;(Daily Scrum, Impediments)&#10;Loop"
          style="rounded=1;dashed=1;whiteSpace=wrap;html=1"
          vertex="1" parent="1">
          <mxGeometry x="740" y="320" width="320" height="160" as="geometry"/>
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gw1" value="Sprint Goal Met?"
          style="rhombus;whiteSpace=wrap;html=1"
          vertex="1" parent="1">
          <mxGeometry x="1120" y="370" width="60" height="60" as="geometry"/>
        </mxCell>

        <!-- Review -->
        <mxCell id="review" value="Sprint Review&#10;(PO ↔ DEV, SH)"
          style="rounded=1;whiteSpace=wrap;html=1"
          vertex="1" parent="1">
          <mxGeometry x="1220" y="340" width="280" height="120" as="geometry"/>
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gw2" value="Increment Accepted?"
          style="rhombus;whiteSpace=wrap;html=1"
          vertex="1" parent="1">
          <mxGeometry x="1540" y="370" width="60" height="60" as="geometry"/>
        </mxCell>

        <!-- Retrospective -->
        <mxCell id="retro" value="Retrospective&#10;(SM ↔ PO, DEV)"
          style="rounded=1;whiteSpace=wrap;html=1"
          vertex="1" parent="1">
          <mxGeometry x="1660" y="340" width="300" height="120" as="geometry"/>
        </mxCell>

        <!-- End Event -->
        <mxCell id="end" value="Sprint Complete"
          style="ellipse;whiteSpace=wrap;html=1;aspect=fixed"
          vertex="1" parent="1">
          <mxGeometry x="2020" y="380" width="40" height="40" as="geometry"/>
        </mxCell>

        <!-- SEQUENCE FLOWS -->
        <mxCell id="f1" edge="1" parent="1" source="start" target="plan"
          style="endArrow=block;html=1">
